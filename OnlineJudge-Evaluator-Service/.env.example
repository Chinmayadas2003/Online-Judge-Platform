# Algocode-Evaluator-Service .env example
# This service runs code execution containers and the evaluation workers.
# Copy this file to .env and replace values before running.

# HTTP server
PORT=3000

# Redis (used by BullMQ queues)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Optional if your Redis requires a password
# REDIS_PASSWORD=

# Docker (dockerode will use the local Docker daemon). On Windows, ensure Docker Desktop is running with Linux containers.
# Optionally override docker socket/host if needed (e.g. tcp://docker:2375)
# DOCKER_HOST=

# Optional: Override default images (defaults are in src/utils/constants.ts)
# JAVA_IMAGE=openjdk:11-jdk-slim
# PYTHON_IMAGE=python:3.8-slim
# CPP_IMAGE=gcc:latest
