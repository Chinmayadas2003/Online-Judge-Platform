# Algocode-Problem-Service .env example
# This service stores problem data (MongoDB / Mongoose)
# Copy to .env and fill in connection strings.

# HTTP server
PORT=3002

# MongoDB Atlas connection string for problems
ATLAS_DB_URL=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/problems?retryWrites=true&w=majority

# Optional log DB (separate Mongo instance)
LOG_DB_URL=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/logs?retryWrites=true&w=majority

# Environment
NODE_ENV=development
