# AlgoCode-Socket-Service .env example
# WebSocket / Socket.IO service for real-time notifications

# HTTP / Socket server port
PORT=3001

# Redis used as a simple key-value for socketId mapping (ioredis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# Frontend origin allowed for CORS (used in server.js)
FRONTEND_ORIGIN=http://localhost:5500

# If you want to run socket server on a different host/port
# SOCKET_SERVER_URL=http://localhost:3001
